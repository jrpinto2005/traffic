<?xml version="1.0" encoding="UTF-8"?>
<!--
T0.2 reference scenario — nodes.

Four approaches (compass points) around one central signalized junction, each 200 m out
per the ticket. Outer nodes are plain priority nodes (they exist only to anchor the far end
of each approach edge, not to model anything); all the interesting behaviour is at C.
-->
<nodes>
    <!--
    Outer nodes are placed 210.4 m from the centre, not 200 m. netconvert trims each
    approach edge where it meets the junction's own geometric footprint (turning-radius
    corners for a 2-lane signalized junction consume ~10.4 m at this lane count/speed), so
    a 200.0 m node-to-node span produces a 189.6 m travel edge. Placed empirically: build
    once at 200 m, read the resulting edge length back with sumolib, adjust, rebuild. See
    research/M0_reference_scenario.md Q1.
    -->
    <node id="C" x="0"      y="0"      type="traffic_light"/>
    <node id="N" x="0"      y="210.4"  type="priority"/>
    <node id="S" x="0"      y="-210.4" type="priority"/>
    <node id="E" x="210.4"  y="0"      type="priority"/>
    <node id="W" x="-210.4" y="0"      type="priority"/>
</nodes>
